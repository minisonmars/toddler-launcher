<?xml version="1.0" encoding="utf-8"?>
<!-- Only in the GitHub version: the built-in updater downloads and installs new APKs itself.
     The Play version is updated by Google Play instead, so it has none of this. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets the launcher update itself (and apps it installed) without Android's extra
         confirm screen (Android 12+), once it installed the previous version itself -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />
    </application>

</manifest>
