<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Used only to check for and download app updates from GitHub -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets the setup screen ask Android not to put Toddler Guard to sleep -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Only to show whether Wi-Fi, mobile data and Bluetooth are on, in the parent area -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets the remote page add Wi-Fi networks for the device to join (network suggestions) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Lets the launcher see every app that has an icon (Android 11+ hides them otherwise) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Toddler Launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- The toddler home screen. It is both a normal app and a home screen (launcher). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ParentActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <!-- Toddler Guard: sends the child back home if a blocked app or the notification shade opens -->
        <service
            android:name=".GuardService"
            android:exported="true"
            android:label="Toddler Guard"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guard" />
        </service>
    </application>

</manifest>
